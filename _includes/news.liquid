<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="news-list-wrap"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <ol class="news-list">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <li class="news-item">
            <time class="news-date" datetime="{{ item.date | date_to_xmlschema }}">
              <span class="news-date-month">{{ item.date | date: '%b' }}</span>
              <span class="news-date-day">{{ item.date | date: '%d' }}</span>
              <span class="news-date-year">{{ item.date | date: '%Y' }}</span>
            </time>
            <div class="news-body">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ol>
    </div>
  {% else %}
    <p class="news-empty">No news so far...</p>
  {% endif %}
</div>
