<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
  </head>

  <!-- Body -->
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="container mt-5{% if page.permalink == '/' %} home-container{% endif %}" role="main">
      {% if page.toc and page.toc.sidebar %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row toc-layout toc-collapsed toc-right">
            <!-- main content area -->
            <div class="col-sm-12 toc-main">{{ content }}</div>
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3 toc-sidebar-col">
              <div class="toc-panel">
                <div class="toc-panel-title">On this page</div>
                <nav id="toc-sidebar" class="sticky-top"></nav>
              </div>
            </div>
          </div>
        {% else %}
          <div class="row toc-layout toc-collapsed toc-left">
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3 toc-sidebar-col">
              <div class="toc-panel">
                <div class="toc-panel-title">On this page</div>
                <nav id="toc-sidebar" class="sticky-top"></nav>
              </div>
            </div>
            <!-- main content area -->
            <div class="col-sm-12 toc-main">{{ content }}</div>
          </div>
        {% endif %}
        <button class="toc-toggle-button" type="button" aria-controls="toc-sidebar" aria-expanded="false">
          <span class="toc-toggle-caret" aria-hidden="true"></span>
          <span>Contents</span>
        </button>
      {% else %}
        {{ content }}
      {% endif %}
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}
  </body>
</html>
