  url     = {https://doi.org/10.1145/3727980},
  pdf     = {https://dl.acm.org/doi/pdf/10.1145/3727980},
  bibtex_show = {true},
  abstract = {This article presents a data-centric chip design agent framework for Verilog generation. It combines pre-fine-tuning data preparation with post-fine-tuning optimization, using automated Verilog and EDA-script augmentation, RTL-level feedback, iterative filtering, and prompt-guided search to improve LLM-generated RTL quality and PPA-aware design outcomes.},
