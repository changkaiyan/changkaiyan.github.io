@article{chang2025scalegs,
  abbr    = {TACO},
  title   = {ScaleGS: Closing the Gap between Real-time 3D Gaussian Splatting and Real-time XR Rendering},
  author  = {Chang, Kaiyan and Gan, Yiming and Zhu, Wenlong and Wang, Kun and Chen, Zhirong and Cheng, Yuan and Han, Yinhe and Li, Huawei and Wang, Ying},
  journal = {ACM Transactions on Architecture and Code Optimization},
  year    = {2025},
  preview = {scalegs.svg},
  doi     = {10.1145/3774425},
  url     = {https://doi.org/10.1145/3774425},
  pdf     = {https://dl.acm.org/doi/pdf/10.1145/3774425},
  bibtex_show = {true},
  abstract = {ScaleGS is an algorithm-architecture co-design system for real-time multi-object 3D Gaussian Splatting in XR rendering. It restructures the rendering pipeline around object-level behavior, separates static and moving objects, exploits parallelism and data reuse across objects and stages, and combines runtime scheduling with hardware acceleration to improve throughput while preserving rendering quality.},
  impact  = {CCF-A},
  selected = {true},
  annotation = {CCF-A}
}

@article{chang2025largeprocessor,
  abbr    = {SCIS},
  title   = {Large processor chip model},
  author  = {Chang*, Kaiyan and Chen*, Mingzhi and Chen*, Yunji and Chen*, Zhirong and Fan*, Dongrui and Gong*, Junfeng and Guo*, Nan and Han*, Yinhe and Hao*, Qinfen and Hou*, Shuo and Huang*, Xuan and Jin*, Pengwei and Ke*, Changxin and Li*, Cangyuan and Li*, Guangli and Li*, Huawei and Li*, Kuan and Li*, Naipeng and Liang*, Shengwen and Liu*, Cheng and Liu*, Hongwei and Liu*, Jiahua and Lv*, Junliang and Mu*, Jianan and Qin*, Jin and Sun*, Bin and Wang*, Chenxi and Wang*, Duo and Wang*, Mingjun and Wang*, Ying and Wu*, Chenggang and Wu*, Peiyang and Wu*, Teng and Xiao*, Xiao and Xie*, Mengyao and Xiong*, Chenwei and Xu*, Ruiyuan and Yan*, Mingyu and Ye*, Xiaochun and Yu*, Kuai and Zhang*, Rui and Zhang*, Shuoming and Zhao*, Jiacheng},
