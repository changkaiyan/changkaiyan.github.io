  preview = {overview-processor-model.png},
  doi     = {10.48550/arXiv.2506.02929},
  url     = {https://arxiv.org/abs/2506.02929},
  pdf     = {https://arxiv.org/pdf/2506.02929},
  bibtex_show = {true},
  abstract = {This paper introduces the Large Processor Chip Model (LPCM), an LLM-driven framework for end-to-end automated computer architecture design. LPCM organizes automation into human-centric, agent-orchestrated, and model-governed levels, uses 3D Gaussian Splatting as a representative workload, and discusses a path from software-hardware co-design toward more autonomous processor-chip design.},
