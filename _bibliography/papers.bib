@article{chang2023chipgpt,
  abbr     = {Preprint},
  title    = {ChipGPT: How far are we from natural language hardware design},
  author   = {Chang, Kaiyan and Wang, Ying and Ren, Haimeng and Wang, Mengdi and Liang, Shengwen and Han, Yinhe and Li, Huawei and Li, Xiaowei},
  year     = {2023},
  preview  = {overview-chipgpt.png},
  doi      = {10.48550/arXiv.2305.14019},
  url      = {https://arxiv.org/abs/2305.14019},
  pdf      = {https://arxiv.org/pdf/2305.14019},
  bibtex_show = {true},
  scholar_query = {ChipGPT: How far are we from natural language hardware design},
  citations = {200+},
  abstract = {This work explores whether large language models can generate hardware logic designs from natural-language specifications. It presents ChipGPT, a zero-code logic design framework that prompts an LLM, repairs and optimizes generated Verilog, builds a design space, and searches for implementations under target metrics, showing improved programmability and broader optimization space over native LLM use alone.},
  impact   = {Trending CS Papers Top 8 in Hardware Architecture, 09/2024},
  selected = {true},
  annotation = {Trending CS Papers Top 8 in Hardware Architecture, 09/2024}
}

@inproceedings{chang2025llmulator,
